// Traduccion automatica de Dara a F1Code (.f1)

garage engine edad := 0;
garage engine contador := 0;
garage engine resultado := 0;
pitstop edad;
resultado := (edad * 2);
contador := 1;
race ((edad >= 18)) {
    radio resultado;
} overtake {
    radio edad;
}
lap ((contador <= 3)) {
    resultado := (resultado + contador);
    contador := (contador + 1);
}
radio resultado;

finish;
